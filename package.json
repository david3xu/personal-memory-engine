{
  "name": "personal-memory-engine-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "type-check": "pnpm --dir web/owner type-check",
    "test": "node --test tests/contracts/*.test.ts",
    "build": "pnpm --dir web/owner build",
    "check": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test && pnpm build && bash scripts/development/check-rust.sh",
    "desktop:dev": "bash scripts/development/desktop.sh dev",
    "desktop:build": "bash scripts/development/desktop.sh build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "prettier": "^3.6.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@tauri-apps/cli": "^2.8.0"
  }
}
