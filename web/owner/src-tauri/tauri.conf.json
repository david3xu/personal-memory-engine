{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Memory Engine",
  "version": "0.1.0",
  "identifier": "org.personalmemory.engine",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Personal Memory Engine",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/memory-mcp"],
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
